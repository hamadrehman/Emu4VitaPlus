+void BurnSetDefaultVariables()
+{
+    const retro_core_option_definition *options[] = {
+        &var_fba_allow_depth_32,
+        &var_fba_sound_out,
+        &var_fba_frameskip,
+        &var_fba_cpu_speed_adjust,
+        &var_fba_samplerate,
+        &var_fba_sample_interpolation,
+        &var_fba_fm_interpolation,
+    };
+    const size_t optionCount = sizeof(options) / sizeof(options[0]);
+
+    option_defs_us = (retro_core_option_definition *)calloc(optionCount + 1, sizeof(retro_core_option_definition));
+    if (!option_defs_us)
+        return;
+
+    for (size_t i = 0; i < optionCount; i++)
+        option_defs_us[i] = *options[i];
+
+    option_defs_us[optionCount] = var_empty;
+    libretro_set_core_options(environ_cb);
+
+    free(option_defs_us);
+    option_defs_us = NULL;
+}
